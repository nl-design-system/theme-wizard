---
import TokenStoryMatches from '@/components/TokenStoryMatches.astro';
import DesignTokensLayout from '@/layouts/DesignTokensLayout.astro';
import { getStaticPaths as getStaticPathsDesignTokens } from '@/lib/design-tokens/design-tokens-nav';
import { getTokenNamespace } from '@/lib/design-tokens/token-namespaces';
import { capitalize } from 'es-toolkit';
import dlv from 'dlv';

export function getStaticPaths() {
  return getStaticPathsDesignTokens('leaf');
}

const { pageData } = Astro.props;
const namespace = getTokenNamespace(Astro.props.namespace);
const tokenPath = pageData?.metaData?.tokenPath ? namespace.nav.tokenPathFor(pageData.metaData.tokenPath) : undefined;
// A token's `$deprecated`: a message, or `true` without one
const deprecated = pageData?.metaData?.tokenPath
  ? dlv(namespace.getTokens(), pageData.metaData.tokenPath.join('.'))?.$deprecated
  : undefined;
const deprecationMessage =
  typeof deprecated === 'string' ? deprecated : 'Dit token is verouderd en kan in een toekomstige versie verdwijnen.';
---

<DesignTokensLayout title={capitalize(pageData.label)} metaTitle={`${pageData.label} - ${namespace.pageTitle}`}>
  {tokenPath ? (
    <>
      {deprecated && <utrecht-note purpose="warning">Verouderd: {deprecationMessage}</utrecht-note>}
      <wizard-token-docs groups={tokenPath} heading-level="none"></wizard-token-docs>
      <wizard-token-field path={tokenPath} />
      <TokenStoryMatches groups={tokenPath} />
    </>
  ) : null}
</DesignTokensLayout>
