---
import DesignTokensLayout from '@/layouts/DesignTokensLayout.astro';
import TokenNodeContent from '@/components/TokenNodeContent.astro';
import { TOKEN_NAMESPACES, getTokenNamespace } from '@/lib/token-namespaces';
import { capitalize } from 'es-toolkit';

export function getStaticPaths() {
  return TOKEN_NAMESPACES.flatMap((namespace) =>
    namespace.nav.getStaticSlugs(namespace.getTree()).map(({ params }) => ({
      params: { namespace: namespace.id, slug: params.slug },
    })),
  );
}

const namespace = getTokenNamespace(Astro.params.namespace);
const { node, tokenPath } = namespace.nav.resolveSlugPage(
  namespace.getTree(),
  Astro.params.slug,
);
---

<DesignTokensLayout
  title={capitalize(node.key)}
  metaTitle={`${node.key} - ${namespace.pageTitle}`}
>
  <TokenNodeContent namespace={namespace.id} node={node} tokenPath={tokenPath} />
</DesignTokensLayout>
