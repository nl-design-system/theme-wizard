---
import DesignTokensLayout from '@/layouts/DesignTokensLayout.astro';
import { getStaticPaths as getStaticPathsDesignTokens } from '@/lib/design-tokens/design-tokens-nav';
import { getTokenNamespace } from '@/lib/design-tokens/token-namespaces';
import { capitalize } from 'es-toolkit';

export function getStaticPaths() {
  return getStaticPathsDesignTokens('colorBranch');
}

const { pageData } = Astro.props;
const namespace = getTokenNamespace(Astro.props.namespace);
const tokenPath = pageData?.metaData?.tokenPath ? `${namespace.id}.${pageData.metaData.tokenPath.join('.')}`: undefined;
---

<DesignTokensLayout
  title={capitalize(pageData.label)}
  metaTitle={`${pageData.label} - ${namespace.pageTitle}`}
>
  {tokenPath ?
    <wizard-token-docs groups={tokenPath} heading-level="none"></wizard-token-docs>
  : null}

  {pageData.items ?
    <wizard-unstyled-list>
      {
        pageData.items.filter(item => item.metaData?.tokenPath).map((item) => (
          <li>
            <wizard-link-to-token path={`${namespace.id}.${item.metaData.tokenPath.join('.')}`}>
              <a slot="link" href={item.href}>
                Navigeer naar {item.label}
              </a>
              {capitalize(item.label)}
            </wizard-link-to-token>
          </li>
        ))
      }
    </wizard-unstyled-list>
  : null}
</DesignTokensLayout>
