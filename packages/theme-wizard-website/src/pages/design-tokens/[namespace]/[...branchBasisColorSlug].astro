---
import DesignTokensLayout from '@/layouts/DesignTokensLayout.astro';
import TokenNodeContent from '@/components/TokenNodeContent.astro';
import { TOKEN_NAMESPACES, getTokenNamespace } from '@/lib/token-namespaces';
import { capitalize } from 'es-toolkit';

export function getStaticPaths() {
  return TOKEN_NAMESPACES.flatMap((namespace) =>
    namespace.nav.getStaticSlugs(namespace.getTree())
      .filter(({ params }) => {
        const slug = params.slug;
        const parts = slug.split('/');
        return (
          slug.startsWith('color/') &&
          parts.length === 2 &&
          !slug.includes('transparent')
        );
      })
      .map(({ params }) => ({
        params: { namespace: namespace.id, branchBasisColorSlug: params.slug },
      })),
  );
}

const namespace = getTokenNamespace(Astro.params.namespace);
const { node } = namespace.nav.resolveSlugPage(
  namespace.getTree(),
  Astro.params.branchBasisColorSlug,
);
---

<DesignTokensLayout
  title={capitalize(node.key)}
  metaTitle={`${node.key} - ${namespace.pageTitle}`}
>
  <mark>Basis color branch</mark>
</DesignTokensLayout>
