---
import DesignTokensLayout from '@/layouts/DesignTokensLayout.astro';
import { customNavigationConfigBasis } from '@/lib/design-tokens-nav';
import { getTokenNamespace } from '@/lib/token-namespaces';
import { capitalize } from 'es-toolkit';

export function getStaticPaths() {
  return customNavigationConfigBasis
    .filter(page => page.href.includes('/color/'))
    .map(page => {
      const segments = page.href.split('/').slice(1);
      const namespace = segments[1];
      // remove first segment and recreate the href
      const slug = segments.slice(2).join('/');
      return {
        params: { ['collectionColor']: slug, namespace },
        props: {
          namespace,
          pageData: page
        },
      }
    })
}

const { label, groups } = Astro.props.pageData;
const namespace = getTokenNamespace(Astro.props.namespace);
---

<DesignTokensLayout
  title={capitalize(label)}
  metaTitle={`${label} - ${namespace.pageTitle}`}
>
  <mark>Color collection</mark>

  <wizard-unstyled-list>
    {
      groups.map((group) => (
        <li>
          <wizard-link-to-token path={group}>
            <a slot="link" href={`/design-tokens/${group.replaceAll('.', '/')}`}>
              group
            </a>
            {capitalize(group)}
          </wizard-link-to-token>
        </li>
      ))
    }
  </wizard-unstyled-list>
</DesignTokensLayout>
