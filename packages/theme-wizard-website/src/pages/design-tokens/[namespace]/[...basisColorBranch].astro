---
import TokenLinkList from '@/components/TokenLinkList.astro';
import DesignTokensLayout from '@/layouts/DesignTokensLayout.astro';
import { TOKEN_NAMESPACES, getTokenNamespace } from '@/lib/token-namespaces';
import { capitalize } from 'es-toolkit';

export function getStaticPaths() {
  return TOKEN_NAMESPACES.flatMap((namespace) => namespace.nav.getStaticPaths({tree: namespace.getTree(), astroPageFragment: 'basisColorBranch'}));
}

const { node, tokenPath } = Astro.props.pageData;
const namespace = getTokenNamespace(Astro.props.namespace);
---

<DesignTokensLayout
  title={capitalize(node.key)}
  metaTitle={`${node.key} - ${namespace.pageTitle}`}
>
  <wizard-token-docs groups={tokenPath} heading-level="none"></wizard-token-docs>
  <TokenLinkList namespace={namespace.id} nodes={node.children} />
</DesignTokensLayout>
