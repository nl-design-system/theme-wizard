---
import DesignTokensLayout from '@/components/DesignTokensLayout.astro';
import TokenLinkList from '@/components/TokenLinkList.astro';
import { TOKEN_NAMESPACES, getTokenNamespace } from '@/lib/token-namespaces';
import { DESIGN_TOKENS_BASE_URL, type BreadcrumbItem } from '@/lib/token-tree-nav';

export function getStaticPaths() {
  return TOKEN_NAMESPACES.map((namespace) => ({ params: { namespace: namespace.id } }));
}

const namespace = getTokenNamespace(Astro.params.namespace);
const breadcrumbs: BreadcrumbItem[] = [
  { href: DESIGN_TOKENS_BASE_URL, title: 'Design tokens' },
  { href: namespace.href, title: namespace.pageTitle, current: true },
];
---

<DesignTokensLayout
  title={`${namespace.pageTitle} - Theme Wizard`}
  current={{ namespace: namespace.id, segments: [] }}
  breadcrumbs={breadcrumbs}
>
  <clippy-heading level="1">{namespace.heading}</clippy-heading>
  <TokenLinkList namespace={namespace.id} nodes={namespace.getTree()} />
</DesignTokensLayout>
