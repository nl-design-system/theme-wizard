---
import DesignTokensLayout from '@/layouts/DesignTokensLayout.astro';
import TokenLinkList from '@/components/TokenLinkList.astro';
import { getStaticPaths as getStaticPathsDesignTokens } from '@/lib/design-tokens/design-tokens-nav';
import { TOKEN_NAMESPACES, getTokenNamespace } from '@/lib/design-tokens/token-namespaces';
import { capitalize } from 'es-toolkit';

export function getStaticPaths() {
  const staticPaths = getStaticPathsDesignTokens('slug');
  return TOKEN_NAMESPACES.map((namespace) => staticPaths.find((path) => path.params.namespace === namespace.id));
}

const { pageData } = Astro.props;
const namespace = getTokenNamespace(Astro.params?.namespace);
---

<DesignTokensLayout title={namespace.heading} metaTitle={namespace.pageTitle}>
  {pageData.items ? (
    <wizard-unstyled-list>
      {pageData.items.map((item) => (
        <li>
          <wizard-link-to-token
            path={item.metaData.tokenPath ? `${namespace.id}.${item.metaData.tokenPath.join('.')}` : undefined}
          >
            <a slot="link" href={item.href}>
              Navigeer naar {item.label}
            </a>
            {capitalize(item.label)}
          </wizard-link-to-token>
        </li>
      ))}
    </wizard-unstyled-list>
  ) : null}
</DesignTokensLayout>
