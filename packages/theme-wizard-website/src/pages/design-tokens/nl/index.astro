---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getDesignTokensNavItems } from '@/lib/design-tokens-nav';
import { getNlTokenTree } from '@/lib/nl-token-nav';
import type { BreadcrumbItem } from '@/lib/token-tree-nav';
import { capitalize } from 'es-toolkit';

const tree = getNlTokenTree();
const navItems = getDesignTokensNavItems({ namespace: 'nl', segments: [] });
const crumbs: BreadcrumbItem[] = [
  { href: '/design-tokens', title: 'Design tokens' },
  { href: '/design-tokens/nl', title: 'NL component tokens', current: true },
];
---

<script>
  import '@nl-design-system-community/clippy-components/clippy-heading';
  import '@nl-design-system-community/clippy-components/clippy-side-navigation';
  import '@nl-design-system-community/clippy-components/clippy-stack';
  import '@nl-design-system-community/clippy-components/clippy-story-preview';
</script>

<BaseLayout title="NL component tokens - Theme Wizard">
  <theme-wizard-app>
    <wizard-layout>
      <wizard-page-header slot="page-header"></wizard-page-header>

      <clippy-side-navigation
        slot="sidebar"
        label="Design tokens"
        items={JSON.stringify(navItems)}
      ></clippy-side-navigation>

      <wizard-container slot="main">
        <clippy-stack size="lg">
          <utrecht-breadcrumb-nav json={JSON.stringify(crumbs)}></utrecht-breadcrumb-nav>
          <main>
            <clippy-story-preview size="lg">
              <clippy-stack size="lg">
                <clippy-heading level="1">Candidate component tokens</clippy-heading>

                <ul role="list" class="wizard-secretly-a-list">
                  {
                    tree.map((group) => (
                      <li>
                        <wizard-link-to-token path={`nl.${group.path.join('.')}`}>
                          <a slot="link" href={`/design-tokens/nl/${group.path.join('/')}`}>
                            Bewerk '{group.key}'
                          </a>
                          {capitalize(group.key)}
                        </wizard-link-to-token>
                      </li>
                    ))
                  }
                </ul>
              </clippy-stack>
            </clippy-story-preview>
          </main>
        </clippy-stack>
      </wizard-container>
    </wizard-layout>
  </theme-wizard-app>
</BaseLayout>

<style>
  .wizard-secretly-a-list {
    display: flex;
    flex-direction: column;
    list-style-type: none;
    padding-inline-start: var(--basis-space-none);
    row-gap: var(--basis-space-row-md);
  }
</style>
