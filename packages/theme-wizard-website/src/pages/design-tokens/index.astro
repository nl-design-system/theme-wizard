---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getDesignTokensNavItems } from '@/lib/design-tokens-nav';
import { getNavigationItems } from '@/navigation.config';

const navItems = getDesignTokensNavItems();
const navigationItems = getNavigationItems(Astro.url.pathname);
---

<BaseLayout title="Design tokens - Theme Wizard">
  <theme-wizard-app>
    <wizard-layout>
      <wizard-page-header slot="page-header" navigation-items={JSON.stringify(navigationItems)}></wizard-page-header>

      <clippy-side-navigation
        slot="sidebar"
        label="Design tokens"
        items={JSON.stringify(navItems)}
      ></clippy-side-navigation>

      <wizard-container slot="main">
        <main>
          <clippy-story-preview size="lg">
            <clippy-stack size="lg">
              <clippy-heading level="1">Design tokens</clippy-heading>

              <ul role="list" class="wizard-secretly-a-list">
                <li>
                  <wizard-link-to-token path="basis">
                    <a slot="link" href="/design-tokens/basis">Ga naar 'basis' design tokens</a>
                    Basis tokens
                  </wizard-link-to-token>
                </li>
                <li>
                  <wizard-link-to-token path="nl">
                    <a slot="link" href="/design-tokens/nl">Ga naar 'nl' design tokens</a>
                    Candidate components
                  </wizard-link-to-token>
                </li>
              </ul>
            </clippy-stack>
          </clippy-story-preview>
        </main>
      </wizard-container>
    </wizard-layout>
  </theme-wizard-app>
</BaseLayout>

<script>
  import '@nl-design-system-community/clippy-components/clippy-heading';
  import '@nl-design-system-community/clippy-components/clippy-side-navigation';
  import '@nl-design-system-community/clippy-components/clippy-stack';
  import '@nl-design-system-community/clippy-components/clippy-story-preview';
</script>

<style>
  .wizard-secretly-a-list {
    display: flex;
    flex-direction: column;
    list-style-type: none;
    padding-inline-start: var(--basis-space-none);
    row-gap: var(--basis-space-row-md);
  }
</style>
