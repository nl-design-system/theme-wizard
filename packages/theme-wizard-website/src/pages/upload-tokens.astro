---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Upload je thema" metaTitle="Upload thema" layoutSize="xs" layoutBlockAlignment="center">
  <clippy-story-preview size="lg">
    <wizard-theme-preset-form></wizard-theme-preset-form>
  </clippy-story-preview>
</MainLayout>

<script>
  import { navigate } from "astro:transitions/client"

  document.querySelector('theme-wizard-app')?.addEventListener('theme-upload', () => {
    navigate('/design-tokens/basis')
  })
</script>
