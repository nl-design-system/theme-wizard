---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Upload je thema - Theme Wizard">
  <theme-wizard-app>
    <clippy-page-layout layout-block-alignment="center">
      <wizard-page-header slot="header"></wizard-page-header>
      <clippy-layout size="xs">
        <clippy-main id="content">
          <header slot="header">
            <clippy-heading level="1">Upload je thema</clippy-heading>
          </header>
          <clippy-story-preview size="lg">
            <wizard-theme-preset-form></wizard-theme-preset-form>
          </clippy-story-preview>
        </clippy-main>
      </clippy-layout>

      <wizard-page-footer slot="footer"></wizard-page-footer>
    </clippy-page-layout>
  </theme-wizard-app>
</BaseLayout>

<script>
  import { navigate } from "astro:transitions/client"
  import '@nl-design-system-community/clippy-components/clippy-page-layout';
  import '@nl-design-system-community/clippy-components/clippy-layout';
  import '@nl-design-system-community/clippy-components/clippy-main';
  import '@nl-design-system-community/clippy-components/clippy-heading';

  document.querySelector('theme-wizard-app')?.addEventListener('theme-upload', () => {
    navigate('/basis-tokens')
  })
</script>

<style>
  .wizard-main {
    padding-block: var(--basis-space-block-5xl);
  }

  wizard-container {
    margin-inline: auto;
  }
</style>
