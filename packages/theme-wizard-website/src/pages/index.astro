---
import BaseLayout from '../layouts/BaseLayout.astro';
import { IconLink, IconArrowRight, IconFileSpark, IconFileCode } from '@tabler/icons-react'

export const items = [
  {
    title: 'Met de huisstijl van een website',
    linkLabel: 'Navigeer naar \'Huisstijl ophalen\'',
    description: 'Jij vult een URL in. Wij halen de huisstijl op.',
    href: '/scrape-tokens',
    icon: IconLink
  },
  {
    title: 'Met het Start thema',
    linkLabel: 'Navigeer naar \'Start\'',
    description: 'Begin met het Start thema en pas aan waar nodig.',
    href: '/wizard',
    icon: IconFileSpark
  },
  {
    title: 'Met een eigen thema',
    linkLabel: 'Navigeer naar \'Thema uploaden\'',
    description: 'Upload je JSON bestand',
    href: '/upload-tokens',
    icon: IconFileCode,
  }
]
---

<BaseLayout title="Theme Wizard">
  <theme-wizard-app>
    <wizard-layout>
      <wizard-page-header slot="page-header"></wizard-page-header>
      <main slot="main" class="wizard-main">
        <wizard-container size="md">
          <clippy-story-preview size="lg">
            <clippy-stack size="4xl">
              <clippy-heading level="1">Hoe wil je starten?</clippy-heading>

              <clippy-stack size="lg">
                {items.map(link => (
                  <clippy-card-as-link variant="list-item" class="wizard-card">
                    <a href={link.href} slot="link">{link.linkLabel}</a>
                    <span slot="pre-header" class="wizard-card__pre-header" aria-hidden="true">
                      <link.icon />
                    </span>
                    <span slot="header">
                      <clippy-heading level="2" class="wizard-card__title">{link.title}</clippy-heading>
                      <p class="nl-paragraph wizard-card__description">{link.description}</p>
                    </span>
                    <span slot="footer" class="wizard-card__footer" aria-hidden="true">
                      <IconArrowRight />
                    </span>
                  </clippy-card-as-link>
                ))}
              </clippy-stack>
            </clippy-stack>
          </clippy-story-preview>
        </wizard-container>
      </main>
     </wizard-layout>
  </theme-wizard-app>
</BaseLayout>

<script>
  import '@nl-design-system-community/clippy-components/clippy-heading'
  import '@nl-design-system-community/clippy-components/clippy-card-as-link'
  import '@nl-design-system-community/clippy-components/clippy-stack'
  import '@nl-design-system-community/clippy-components/clippy-story-preview'
</script>

<style>
  .wizard-main {
    display: grid;
    place-content: center;
  }

  .wizard-card {
    --nl-heading-level-2-font-size: var(--basis-text-font-size-md);
    --clippy-card-pre-header-padding-inline-end: var(--basis-space-none);
  }

  .wizard-card__pre-header {
    color: var(--basis-color-accent-1-color-default);
  }

  .wizard-card__description {
    color: var(--basis-color-default-color-subtle);
    margin-block: var(--basis-space-none);
  }

  .wizard-card__footer {
    color: var(--basis-color-default-color-subtle);
    transition: translate 100ms ease-out;

    @media not (prefers-reduced-motion: reduce) {
      .wizard-card:hover & {
        translate: var(--basis-space-inline-sm);
      }
    }
  }
</style>
