---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Theme Wizard">
  <theme-wizard-app>
    <wizard-layout>
      <wizard-page-nav slot="page-nav"></wizard-page-nav>
      <main slot="main" class="wizard-main">
        <wizard-container size="md">
          <clippy-story-preview size="lg">
            <wizard-starter-picker></wizard-starter-picker>
          </clippy-story-preview>
        </wizard-container>
      </main>
     </wizard-layout>
  </theme-wizard-app>
</BaseLayout>

<style>
  .wizard-main {
    display: grid;
    place-content: center;
  }
</style>

<script>
  import { navigate } from "astro:transitions/client";
  import {
    WIZARD_STARTER_PICKER_SUBMIT_EVENT,
    type WizardStarterPickerSubmitEventDetail,
  } from "@nl-design-system-community/theme-wizard-app/components/wizard-starter-picker";

  document.querySelector('theme-wizard-app')?.addEventListener(WIZARD_STARTER_PICKER_SUBMIT_EVENT, (event) => {
    const { value } = (event as CustomEvent<WizardStarterPickerSubmitEventDetail>).detail;

    if (value === 'url') {
      navigate('/scrape-tokens');
    } else if (value === 'start') {
      navigate('/wizard');
    }
  })
</script>
