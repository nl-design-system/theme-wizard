---
import BaseLayout from '../layouts/BaseLayout.astro';
import { IconLink, IconFileSpark, IconFileCode } from '@tabler/icons-react'

export const items = [
  {
    title: 'Met de huisstijl van een website',
    linkLabel: 'Navigeer naar \'Huisstijl ophalen\'',
    description: 'Jij vult een URL in. Wij halen de huisstijl op.',
    href: '/scrape-tokens',
    icon: IconLink
  },
  {
    title: 'Met het Start thema',
    linkLabel: 'Navigeer naar \'Start\'',
    description: 'Begin met het Start thema en pas aan waar nodig.',
    href: '/wizard',
    icon: IconFileSpark
  },
  {
    title: 'Met een eigen thema',
    linkLabel: 'Navigeer naar \'Thema uploaden\'',
    description: 'Upload je JSON bestand',
    href: '/upload-tokens',
    icon: IconFileCode,
  }
]
---

<script>
  import '@nl-design-system-community/clippy-components/clippy-heading'
  import '@nl-design-system-community/clippy-components/clippy-stack'
  import '@nl-design-system-community/clippy-components/clippy-story-preview'
  import '@nl-design-system-community/clippy-components/clippy-page-layout';
  import '@nl-design-system-community/clippy-components/clippy-layout';
  import '@nl-design-system-community/clippy-components/clippy-main';
</script>

<BaseLayout title="Theme Wizard">
  <theme-wizard-app>
    <clippy-page-layout layout-block-alignment="center">
      <wizard-page-header slot="header"></wizard-page-header>
      <clippy-layout size="xs">
        <clippy-main id="content">
          <header slot="header">
            <clippy-heading level="1">Hoe wil je starten?</clippy-heading>
          </header>

          <clippy-story-preview size="lg">
            <clippy-stack size="lg">
              {items.map(link => (
                <wizard-card-as-link>
                  <a href={link.href} slot="link">{link.linkLabel}</a>
                  <link.icon slot="pre-header" aria-hidden="true" />
                  <clippy-heading level="2" slot="header">{link.title}</clippy-heading>
                  <p class="nl-paragraph" slot="body">{link.description}</p>
                </wizard-card-as-link>
              ))}
            </clippy-stack>
          </clippy-story-preview>

        </clippy-main>
      </clippy-layout>

      <wizard-page-footer slot="footer"></wizard-page-footer>
    </clippy-page-layout>
  </theme-wizard-app>
</BaseLayout>
