---
import StyleGuideNav from "@/components/StyleGuideNav.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import TokenStoryMatches from '@/components/TokenStoryMatches.astro';
import { capitalize } from 'es-toolkit/string';

const SECTIONS = [
  {
    name: "Kader- of lijndikte",
    id: 'border-width',
    tokens: ['none', 'sm', 'md', 'lg'],
  },
  {
    name: "Afgeronde hoeken",
    id: 'border-radius',
    tokens: ['none', 'sm', 'md', 'lg', 'round'],
  },
]
---

<script>
  import '@nl-design-system-community/clippy-components/clippy-stack';
  import '@nl-design-system-community/clippy-components/clippy-story-preview';
  import '@nl-design-system-community/clippy-components/clippy-heading';
</script>

<BaseLayout title="Randen en lijnen systeem - Stijlgids - Theme Wizard">
  <theme-wizard-app>
    <wizard-layout>
      <wizard-page-nav slot="page-nav"></wizard-page-nav>
      <StyleGuideNav />
      <wizard-anchor-nav slot="aside-nav" items={JSON.stringify(SECTIONS.map(section => ({title: section.name, id: section.id})))}></wizard-anchor-nav>
      <wizard-container slot="main">
        <clippy-stack size="3xl">
          <clippy-heading level="1">Randen en lijnen systeem</clippy-heading>

          <clippy-stack size="5xl">
            {SECTIONS.map(section => (
              <section class="wizard-token-section" id={section.id}>
                <clippy-stack size="xl">
                  <wizard-token-docs groups={`basis.${section.id}`} heading-level="2"></wizard-token-docs>
                  <clippy-story-preview size="lg">
                    <clippy-stack size="5xl">
                      {section.tokens.map((token) => (
                        <clippy-stack size="2xl">
                          <clippy-heading level="3">{capitalize(token)}</clippy-heading>
                          <wizard-token-table groups={`basis.${section.id}.${token}`}></wizard-token-table>
                          <TokenStoryMatches groups={`basis.${section.id}.${token}`} />
                        </clippy-stack>
                      ))}
                    </clippy-stack>
                  </clippy-story-preview>
                </clippy-stack>
              </section>
            ))}
          </clippy-stack>

        </clippy-stack>
      </wizard-container>
    </wizard-layout>
  </theme-wizard-app>
</BaseLayout>

<style>
  .wizard-token-section {
    scroll-margin-block: calc(var(--wizard-page-nav-block-size, 4rem) + var(--basis-space-row-xl));
  }
</style>
