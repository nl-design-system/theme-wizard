---
import MainLayout from '@/layouts/MainLayout.astro';
import TokenStoryMatches from '@/components/TokenStoryMatches.astro';
import { capitalize } from 'es-toolkit/string';

const SECTIONS = [
  {
    name: "Lettertype",
    id: 'font-family',
    tokens: ['default', 'monospace'],
  },
  {
    name: "Lettergewicht",
    id: 'font-weight',
    tokens: ['default', 'bold'],
  },
  {
    name: "Lettergrootte",
    id: 'font-size',
    tokens: ['sm', 'md', 'lg', 'xl', '2xl', '3xl', '4xl'],
  },
  {
    name: "Regelafstand",
    id: 'line-height',
    tokens: ['sm', 'md', 'lg', 'xl', '2xl', '3xl', '4xl'],
  },
]
---

<script>
  import '@nl-design-system-community/clippy-components/clippy-heading';
  import '@nl-design-system-community/clippy-components/clippy-stack';
  import '@nl-design-system-community/clippy-components/clippy-story-preview';
  import '@nl-design-system-community/clippy-components/clippy-table-of-contents';
</script>

<MainLayout title="Typografie systeem" metaTitle="Typografie systeem" layoutPurpose="detail" mainPath="/style-guide">
  <clippy-table-of-contents slot="aside" items={JSON.stringify(SECTIONS.map(section => ({label: section.name, href: `#${section.id}`})))}></clippy-table-of-contents>

  <clippy-stack size="5xl">
    {SECTIONS.map(section => (
      <section class="wizard-anchor" id={section.id}>
        <clippy-stack size="xl">
          {['line-height', 'font-size'].includes(section.id) ? (
            <wizard-token-docs groups={`basis.text.${section.id}`} heading-level="2"></wizard-token-docs>
          ) : (
            <clippy-heading level="2">{section.name}</clippy-heading>
          )}
          <clippy-story-preview size="lg">
            <clippy-stack size="5xl">
              {section.tokens.map((token) => (
                <clippy-stack size="2xl">
                  {['line-height', 'font-size'].includes(section.id) ? (
                    <clippy-heading level="3">{capitalize(token)}</clippy-heading>
                  ) : (
                    <wizard-token-docs groups={`basis.text.${section.id}.${token}`} heading-level="3"></wizard-token-docs>
                  )}
                  <wizard-token-table groups={`basis.text.${section.id}.${token}`}></wizard-token-table>
                  <TokenStoryMatches groups={`basis.text.${section.id}.${token}`} />
                </clippy-stack>
              ))}
            </clippy-stack>
          </clippy-story-preview>
        </clippy-stack>
      </section>
    ))}
  </clippy-stack>
</MainLayout>
