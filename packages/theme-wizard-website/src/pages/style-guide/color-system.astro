---
import StyleGuideNav from '@/components/StyleGuideNav.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@nl-design-system-community/clippy-components/clippy-story-preview';
import '@nl-design-system-community/clippy-components/clippy-reset-theme';

---

<script>
  import { findMatchingStories } from '@/lib/story-token-matches';
  import { subscribeToLiveTheme } from '@/lib/get-live-theme';

  function renderMatches(container: HTMLElement, matches: Awaited<ReturnType<typeof findMatchingStories>>) {
    container.replaceChildren();

    for (const { id, story, meta } of matches) {
      const section = document.createElement('section');
      section.className = 'wizard-story-section';

      const heading = document.createElement('clippy-heading')
      heading.setAttribute('level', '3')
      heading.textContent = id
        .replace(/^Design/, '')
        .replace(/([A-Z])/g, ' $1')
        .trim()

      const preview = document.createElement('clippy-story-preview');
      const reset = document.createElement('clippy-reset-theme');
      const previewTheme = document.createElement('wizard-preview-theme');

      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      const storyRenderer = document.createElement('wizard-story-react') as any;
      storyRenderer.story = story;
      storyRenderer.componentMeta = meta;
      storyRenderer.args = (story as { args?: unknown }).args ?? {};

      previewTheme.appendChild(storyRenderer);
      reset.appendChild(previewTheme);
      preview.append(heading, reset);
      section.append(preview);
      container.appendChild(section);
    }
  }

  const containers = [...document.querySelectorAll<HTMLElement>('[data-token-story-matches]')];

  if (containers.length > 0) {
    // One subscription is enough, the theme is shared across the whole page.
    subscribeToLiveTheme(containers[0], async (theme) => {
      for (const container of containers) {
        const groups = (container.dataset.groups ?? '')
          .split(',')
          .map((group) => group.trim())
          .filter(Boolean);

        if (groups.length === 0) continue;

        const matches = await findMatchingStories(groups, theme.tokens);
        renderMatches(container, matches);
      }
    });
  }
</script>

<BaseLayout title="Stijlgids kleur systeem - Theme Wizard">
  <theme-wizard-app>
    <wizard-layout>
      <wizard-page-nav slot="page-nav"></wizard-page-nav>
      <StyleGuideNav />

      <wizard-container slot="main">
        <wizard-stack size="3xl">
          <clippy-heading level="1">Kleur systeem</clippy-heading>

          <wizard-stack size="3xl">
            <section>
              <clippy-story-preview>
                <wizard-stack size="2xl">
                  <clippy-heading level="2">Huisstijl</clippy-heading>
                  <wizard-color-system-preview groups="default, accent-1, accent-2, accent-3"></wizard-color-system-preview>

                  <div data-token-story-matches data-groups="accent-1, accent-2, accent-3"></div>
                </wizard-stack>
              </clippy-story-preview>
            </section>

            <section>
              <clippy-story-preview>
                <wizard-stack size="2xl">
                  <clippy-heading level="2">Interactie</clippy-heading>
                  <wizard-color-system-preview groups="action-1, action-2, disabled"></wizard-color-system-preview>

                  <div data-token-story-matches data-groups="action-1, action-2, disabled"></div>
                </wizard-stack>
              </clippy-story-preview>
            </section>

            <section>
              <clippy-story-preview>
                <wizard-stack size="2xl">
                  <clippy-heading level="2">Signaal</clippy-heading>
                  <wizard-color-system-preview groups="info, positive, negative, warning"></wizard-color-system-preview>

                  <div data-token-story-matches data-groups="info, positive, negative, warning"></div>
                </wizard-stack>
              </clippy-story-preview>
            </section>

            <section>
              <clippy-story-preview>
                <wizard-stack size="2xl">
                  <clippy-heading level="2">Overig</clippy-heading>
                  <wizard-color-system-preview groups="highlight, selected"></wizard-color-system-preview>

                  <div data-token-story-matches data-groups="highlight, selected"></div>
                </wizard-stack>
              </clippy-story-preview>
            </section>

          </wizard-stack>
        </wizard-stack>
      </wizard-container>
    </wizard-layout>
  </theme-wizard-app>
</BaseLayout>


<style>
  [data-token-story-matches] {
    background: whitesmoke;
    display: flex;
    flex-wrap: wrap;
    row-gap: 1rem;
    column-gap: 1rem;
    padding-inline: 1rem;
    padding-block: 1rem;

    --nl-heading-level-3-font-size: 1rem;
    --nl-heading-level-3-margin-block-end: 0.75rem;
  }
</style>