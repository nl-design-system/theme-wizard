---
import StyleguideLayout from "@/layouts/StyleguideLayout.astro"
import { getNavigationItems, getSubNavigationItems } from "@/navigation.config";

const navigationItems = getNavigationItems(Astro.url.pathname);
const subNavigationItems = getSubNavigationItems(navigationItems, '/style-guide');
---

<script>
import '@nl-design-system-community/clippy-components/clippy-heading'
import '@nl-design-system-community/clippy-components/clippy-page-layout';
import '@nl-design-system-community/clippy-components/clippy-layout';
import '@nl-design-system-community/clippy-components/clippy-main';
</script>

<StyleguideLayout title="Stijlgids">
  <clippy-story-preview size="lg">
    <wizard-unstyled-list>
      {subNavigationItems.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </wizard-unstyled-list>
  </clippy-story-preview>
</StyleguideLayout>
