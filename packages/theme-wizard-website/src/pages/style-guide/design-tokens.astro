---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@nl-design-system-community/clippy-components/clippy-stack';
import '@nl-design-system-community/clippy-components/clippy-story-preview';
import StyleGuideNav from '@/components/StyleGuideNav.astro';

const SECTION_IDS = {
  typography: 'typography',
  colors: 'colors',
  spacing: 'spacing',
  components: 'components'
}
---

<BaseLayout title="Design tokens - Stijlgids - Theme Wizard">
  <theme-wizard-app>
    <wizard-layout>
      <wizard-page-nav slot="page-nav"></wizard-page-nav>
      <StyleGuideNav />
      <wizard-anchor-nav slot="aside-nav" items={JSON.stringify([{title: "Typografie", id: SECTION_IDS.typography}, {title: "Kleuren", id: SECTION_IDS.colors}, {title: "Witruimte", id: SECTION_IDS.spacing}, {title: "Componenten", id: SECTION_IDS.components}])}></wizard-anchor-nav>
      <wizard-container slot="main">
        <clippy-stack size="3xl">
          <clippy-heading level="1">Design tokens</clippy-heading>

          <clippy-stack size="5xl">
            <section class="wizard-token-section" id={SECTION_IDS.typography}>
              <clippy-stack size="xl">
                <clippy-heading level="2">Typografie</clippy-heading>
                <clippy-story-preview size="lg">
                  <wizard-style-guide-typography></wizard-style-guide-typography>
                </clippy-story-preview>
              </clippy-stack>
            </section>

            <section class="wizard-token-section" id={SECTION_IDS.colors}>
              <clippy-stack size="xl">
                <clippy-heading level="2">Kleuren</clippy-heading>
                <clippy-story-preview size="lg">
                  <wizard-style-guide-colors></wizard-style-guide-colors>
                </clippy-story-preview>
              </clippy-stack>
            </section>

            <section class="wizard-token-section" id={SECTION_IDS.spacing}>
              <clippy-stack size="xl">
                <clippy-heading level="2">Witruimte</clippy-heading>
                <clippy-story-preview size="lg">
                  <wizard-style-guide-spacing></wizard-style-guide-spacing>
                </clippy-story-preview>
              </clippy-stack>
            </section>

            <section class="wizard-token-section" id={SECTION_IDS.components}>
              <clippy-stack size="xl">
                <clippy-heading level="2">Componenten</clippy-heading>
                <clippy-story-preview size="lg">
                  <wizard-style-guide-components></wizard-style-guide-components>
                </clippy-story-preview>
              </clippy-stack>
            </section>

          </clippy-stack>
        </clippy-stack>
      </wizard-container>
    </wizard-layout>
  </theme-wizard-app>
</BaseLayout>

<style>
  .wizard-token-section {
    scroll-margin-block: calc(var(--wizard-page-nav-block-size, 4rem) + var(--basis-space-row-xl));
  }
</style>
