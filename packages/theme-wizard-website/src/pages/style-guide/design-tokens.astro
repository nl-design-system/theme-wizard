---
import MainLayout from '@/layouts/MainLayout.astro';

const SECTIONS = [
  {
    name: "Typography",
    id: 'typography',
  },
  {
    name: "Kleuren",
    id: 'colors',
  },
  {
    name: "Witruimte",
    id: 'spacing',
  },
  {
    name: "Componenten",
    id: 'components',
  },
]
---

<script>
  import '@nl-design-system-community/clippy-components/clippy-heading';
  import '@nl-design-system-community/clippy-components/clippy-stack';
  import '@nl-design-system-community/clippy-components/clippy-story-preview';
  import '@nl-design-system-community/clippy-components/clippy-table-of-contents';
</script>

<MainLayout title="Design tokens" metaTitle="Design tokens" layoutPurpose="detail" mainPath="/style-guide">
  <clippy-table-of-contents slot="aside" items={JSON.stringify(SECTIONS.map(section => ({label: section.name, href: `#${section.id}`})))}></clippy-table-of-contents>

  <clippy-stack size="5xl">
    <section class="wizard-token-section" id={SECTIONS.find(section => section.id === 'typography')?.id}>
      <clippy-stack size="xl">
        <clippy-heading level="2">{SECTIONS.find(section => section.id === 'typography')?.name}</clippy-heading>
        <clippy-story-preview size="lg">
          <wizard-style-guide-typography></wizard-style-guide-typography>
        </clippy-story-preview>
      </clippy-stack>
    </section>

    <section class="wizard-token-section" id={SECTIONS.find(section => section.id === 'colors')?.id}>
      <clippy-stack size="xl">
        <clippy-heading level="2">{SECTIONS.find(section => section.id === 'colors')?.name}</clippy-heading>
        <clippy-story-preview size="lg">
          <wizard-style-guide-colors></wizard-style-guide-colors>
        </clippy-story-preview>
      </clippy-stack>
    </section>

    <section class="wizard-token-section" id={SECTIONS.find(section => section.id === 'spacing')?.id}>
      <clippy-stack size="xl">
        <clippy-heading level="2">{SECTIONS.find(section => section.id === 'spacing')?.name}</clippy-heading>
        <clippy-story-preview size="lg">
          <wizard-style-guide-spacing></wizard-style-guide-spacing>
        </clippy-story-preview>
      </clippy-stack>
    </section>

    <section class="wizard-token-section" id={SECTIONS.find(section => section.id === 'components')?.id}>
      <clippy-stack size="xl">
        <clippy-heading level="2">{SECTIONS.find(section => section.id === 'components')?.name}</clippy-heading>
        <clippy-story-preview size="lg">
          <wizard-style-guide-components></wizard-style-guide-components>
        </clippy-story-preview>
      </clippy-stack>
    </section>

  </clippy-stack>
</MainLayout>
