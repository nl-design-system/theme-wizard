---
import BaseLayout from '@/layouts/BaseLayout.astro';
import WithPageNav from '@/components/WithPageNav.astro';
import '@nl-design-system-community/clippy-components/clippy-stack';
import '@nl-design-system-community/clippy-components/clippy-story-preview';
import StyleGuideNav from '@/components/StyleGuideNav.astro';

const SECTION_IDS = {
  typography: 'typography',
  colors: 'colors',
  spacing: 'spacing',
  components: 'components'
}
---

<BaseLayout title="Design tokens - Stijlgids - Theme Wizard">
  <theme-wizard-app>
    <wizard-layout>
      <wizard-page-nav slot="page-nav"></wizard-page-nav>
      <StyleGuideNav />

      <wizard-container slot="main">
        <clippy-stack size="3xl">
          <clippy-heading level="1">Design tokens</clippy-heading>

          <clippy-stack size="5xl">
            <section>
              <clippy-story-preview size="lg">
                <clippy-stack size="2xl">
                  <clippy-heading level="2" id={SECTION_IDS.typography}>Typografie</clippy-heading>
                  <wizard-style-guide-typography></wizard-style-guide-typography>
                </clippy-stack>
              </clippy-story-preview>
            </section>

            <section>
              <clippy-story-preview size="lg">
                <clippy-stack size="2xl">
                  <clippy-heading level="2" id={SECTION_IDS.colors}>Kleuren</clippy-heading>
                  <wizard-style-guide-colors></wizard-style-guide-colors>
                </clippy-stack>
              </clippy-story-preview>
            </section>

            <section>
              <clippy-story-preview size="lg">
                <clippy-stack size="2xl">
                  <clippy-heading level="2" id={SECTION_IDS.spacing}>Witruimte</clippy-heading>
                  <wizard-style-guide-spacing></wizard-style-guide-spacing>
                </clippy-stack>
              </clippy-story-preview>
            </section>

            <section>
              <clippy-story-preview size="lg">
                <clippy-stack size="2xl">
                  <clippy-heading level="2" id={SECTION_IDS.components}>Componenten</clippy-heading>
                  <wizard-style-guide-components></wizard-style-guide-components>
                </clippy-stack>
              </clippy-story-preview>
            </section>
          </clippy-stack>
        </clippy-stack>
      </wizard-container>
    </wizard-layout>
  </theme-wizard-app>
</BaseLayout>

<style>
  .wizard-main {
    padding-block-end: var(--basis-space-block-6xl);
    padding-block-start: var(--basis-space-block-4xl);
  }
</style>
