---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getBasisTokenTree } from '@/lib/basis-token-nav';
import { capitalize } from 'es-toolkit';
import { getNavigationItems, getSubNavigationItems } from '@/navigation.config';

const tree = getBasisTokenTree();
const navigationItems = getNavigationItems(Astro.url.pathname);
const subNavigationItems = getSubNavigationItems(navigationItems, '/basis-tokens');
---

<script>
  import '@nl-design-system-community/clippy-components/clippy-heading';
  import '@nl-design-system-community/clippy-components/clippy-side-navigation';
  import '@nl-design-system-community/clippy-components/clippy-story-preview';
</script>

<BaseLayout title="Basis tokens - Theme Wizard">
  <theme-wizard-app>
    <wizard-layout>
      <wizard-page-header slot="page-header" navigation-items={JSON.stringify(navigationItems)}></wizard-page-header>

      <clippy-side-navigation
        slot="sidebar"
        label="Basis tokens"
        items={JSON.stringify(subNavigationItems)}
      ></clippy-side-navigation>

      <wizard-container slot="main">
        <main>
          <clippy-story-preview size="lg">
            <clippy-stack size="lg">
              <clippy-heading level="1">Basis tokens</clippy-heading>

              <ul role="list" class="wizard-secretly-a-list">
                {
                  tree.map((group) => (
                    <li>
                      <wizard-link-to-token path={`basis.${group.path.join('.')}`}>
                        <a slot="link" href={`/basis-tokens/${group.path.join('/')}`}>
                          Bewerk '{group.key}'
                        </a>
                        {capitalize(group.key)}
                      </wizard-link-to-token>
                    </li>
                  ))
                }
              </ul>
            </clippy-stack>
          </clippy-story-preview>
        </main>
      </wizard-container>
    </wizard-layout>
  </theme-wizard-app>
</BaseLayout>

<style>
  .wizard-secretly-a-list {
    display: flex;
    flex-direction: column;
    list-style-type: none;
    padding-inline-start: var(--basis-space-none);
    row-gap: var(--basis-space-row-md);
  }
</style>
