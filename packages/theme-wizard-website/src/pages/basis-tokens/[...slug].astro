---
import TokenStoryMatches from '@/components/TokenStoryMatches.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getBasisTokenTree, toNavigationItems, getBreadcrumbTrail } from '@/lib/basis-token-nav';
import { findTreeNode, flattenTreePaths } from '@nl-design-system-community/design-tokens-schema';
import type { TokenPath } from '@nl-design-system-community/design-tokens-schema';
import { capitalize } from 'es-toolkit';
import { getNavigationItems, getSubNavigationItems } from '@/navigation.config';

const tree = getBasisTokenTree();

export function getStaticPaths() {
  return flattenTreePaths(getBasisTokenTree()).map((path) => ({
    params: { slug: path.join('/') },
  }));
}

const segments = (Astro.params.slug as string).split('/') as TokenPath;
const node = findTreeNode(tree, segments)!;
const navItems = toNavigationItems(tree, segments);
const crumbs = getBreadcrumbTrail(tree, segments);
const tokenPath = `basis.${segments.join('.')}`; // 'basis.color.accent-1'
const isColorGroup = !node.isLeaf && segments.at(0) === 'color' && segments.length === 2; // ['color', 'accent-1']

const navigationItems = getNavigationItems(Astro.url.pathname);
const subNavigationItems = getSubNavigationItems(navigationItems, '/basis-tokens');
---

<script>
  import '@nl-design-system-community/clippy-components/clippy-heading'
  import '@nl-design-system-community/clippy-components/clippy-side-navigation';
  import '@nl-design-system-community/clippy-components/clippy-stack'
</script>

<BaseLayout title={`${node.key} - Basis tokens - Theme Wizard`}>
  <theme-wizard-app>
    <wizard-layout>
      <wizard-page-header slot="page-header" navigation-items={JSON.stringify(navigationItems)}></wizard-page-header>

      <clippy-side-navigation
        slot="sidebar"
        label="Basis tokens"
        items={JSON.stringify(subNavigationItems)}
      ></clippy-side-navigation>

      <wizard-container slot="main">
        <clippy-stack size="lg">
          <utrecht-breadcrumb-nav json={JSON.stringify(crumbs)}></utrecht-breadcrumb-nav>
          <main>
            <clippy-story-preview size="lg">
              <clippy-stack size="lg">
                <clippy-heading level="1">{capitalize(node.key)}</clippy-heading>
                <wizard-token-docs groups={tokenPath} heading-level="none"></wizard-token-docs>

                {
                  node.isLeaf ? (
                    <wizard-token-field path={tokenPath} />
                  ) : (
                    <>
                      <ul role="list" class="wizard-secretly-a-list">
                        {
                          node.children.map((child) => (
                            <li>
                              <wizard-link-to-token path={`basis.${child.path.join('.')}`}>
                                <a slot="link" href={`/basis-tokens/${child.path.join('/')}`}>Bewerk '{child.key}'</a>
                                {capitalize(child.key)}
                              </wizard-link-to-token>
                            </li>
                          ))
                        }
                      </ul>

                      {isColorGroup && (
                        <wizard-color-system-preview groups={tokenPath}></wizard-color-system-preview>
                      )}
                    </>
                  )
                }

                {(node.isLeaf || isColorGroup) &&
                  <TokenStoryMatches groups={tokenPath} />
                }
              </clippy-stack>
            </clippy-story-preview>
          </main>
        </clippy-stack>
      </wizard-container>
    </wizard-layout>
  </theme-wizard-app>
</BaseLayout>

<style>
  .wizard-secretly-a-list {
    display: flex;
    flex-direction: column;
    list-style-type: none;
    padding-inline-start: var(--basis-space-none);
    row-gap: var(--basis-space-row-md);
  }
</style>
