---
import MainLayout from '@/layouts/MainLayout.astro';
import dlv from 'dlv'
import { components } from '@/lib/components'
import { Traverse } from 'neotraverse/modern'
import { getStories } from '@nl-design-system-community/theme-wizard-app/utils';

type StoryObject = {
  name?: string;
  parameters?: {
    editableTokens?: unknown;
    [key: PropertyKey]: unknown;
  };
  [key: PropertyKey]: unknown;
};

export function getStaticPaths() {
  return Object.keys(components).map(slug => ({
    params: { slug }
  }))
}

const slug = Astro.params.slug as keyof typeof components
const { title } = components[slug]
const showDocsLink = components[slug].group === 'candidate'
const nlDesignSystemDocsUrl = new URL('https://nldesignsystem.nl')
nlDesignSystemDocsUrl.pathname = components[slug].slug
const componentModulePromiseFn = components[slug].stories
const componentModule = await componentModulePromiseFn()
const { default: meta, ...storyExports } = componentModule
const stories = getStories(storyExports as unknown as Record<PropertyKey, StoryObject>, meta)
const storyIds = stories.map(([id]) => id)

function getTokenLeaves(tokenObj: any) {
  const leaves: {path: PropertyKey[], value: any}[] = [];
  new Traverse(tokenObj).forEach((ctx, node) => {
    if (ctx.isLeaf) {
      const pathWithoutValue = ctx.path.slice(0, -1)
      leaves.push({
        path: pathWithoutValue,
        value: node
      })
    }
  });
  return leaves;
}

const storiesWithTokens = stories.map(([id, story]) => {
  const storyTokens = (story as any).parameters?.editableTokens
  return ({
    id,
    story,
    tokens: storyTokens
      ? getTokenLeaves(storyTokens).map(leaf => {
        const token = dlv(componentModule.default.parameters?.tokens, leaf.path.join('.'))
        return {
          ...leaf,
          token
        }
      })
      : []
  })
})
---


<script>
  import '@nl-design-system-community/clippy-components/clippy-heading';
  import '@nl-design-system-community/clippy-components/clippy-stack';
  import '@nl-design-system-community/clippy-components/clippy-story-preview';
  import '@nl-design-system-community/clippy-components/clippy-table-of-contents';
</script>

<MainLayout title={title} metaTitle={title} mainPath="/components" layoutPurpose="detail">
  <clippy-table-of-contents slot="aside" items={JSON.stringify(storiesWithTokens.map(({story, id}) => ({ label: story.name, href: `#${id}` })))}></clippy-table-of-contents>

  {showDocsLink && (
    <p class="nl-paragraph" slot="header">
      Bekijk de component-documentatie op <a class="nl-link" href={nlDesignSystemDocsUrl.toString()} target="_blank">nldesignsystem.nl</a>.
    </p>
  )}

  <clippy-story-preview size="lg">
    <clippy-stack size="5xl">
      {storiesWithTokens.map(({id, story, tokens}) => (
        <section id={id} class="wizard-anchor">
          <clippy-stack size="2xl">
            <clippy-heading level="2">{story.name}</clippy-heading>
            <clippy-story-preview>
              <div data-story-container={id}></div>
            </clippy-story-preview>
            {tokens.length > 0 && (
              <wizard-unstyled-list>
                {tokens.map((token) => (
                  <li>
                    <wizard-token-field label={token.path.join('.')} path={token.path.join('.')}></wizard-token-field>
                  </li>
                ))}
              </wizard-unstyled-list>
            )}
          </clippy-stack>
        </section>
      ))}
      <div id="story-container" data-story-ids={JSON.stringify(storyIds)} data-component-id={slug} hidden></div>
    </clippy-stack>
  </clippy-story-preview>
</MainLayout>

<script>
  import { initStories } from '@/components/render-stories';
  import type { components } from '@/lib/components';

  const container = document.getElementById('story-container');
  const storyIds = JSON.parse(container!.dataset.storyIds || '[]');
  // Assertion here is type-safe because that's taken care of by Astro in the top of this file
  const componentId = container?.dataset.componentId! as keyof typeof components

  initStories(componentId, storyIds);
</script>
