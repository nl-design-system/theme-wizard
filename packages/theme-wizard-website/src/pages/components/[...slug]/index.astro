---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { loadStoryWizardComponentStyles } from '@/components/story-wizard/componentStyles';
import StoryWizard from '@/components/story-wizard/index.astro';
import { components } from '@/lib/components';
import { StoryWizardModel } from '@/lib/story-wizard';
import refreshIcon from '@tabler/icons/outline/refresh.svg?raw';
import { getNavigationItems, getSubNavigationItems } from '@/navigation.config';

import './index.css';

export function getStaticPaths() {
  return Object.keys(components).map(slug => ({
    params: { slug }
  }))
}


const slug = Astro.params.slug as keyof typeof components
const { title } = components[slug]
await loadStoryWizardComponentStyles(slug)
const wizard = await StoryWizardModel.fromComponentId(slug)
const navigationItems = getNavigationItems(Astro.url.pathname);
const subNavigationItems = getSubNavigationItems(navigationItems, '/components');
---

<BaseLayout title={`${slug} - Theme Wizard`}>
  <theme-wizard-app>
    <wizard-layout>
      <wizard-page-header slot="page-header" navigation-items={JSON.stringify(navigationItems)}></wizard-page-header>

      {subNavigationItems ?
        <clippy-side-navigation
          slot="sidebar"
          label="Components"
          items={JSON.stringify(subNavigationItems)}
        ></clippy-side-navigation>
      : null}

      <main slot="main" class="wizard-main">
        <!-- TODO: make proper breadcrumb https://github.com/nl-design-system/theme-wizard/issues/531 -->
        <nav>
          <a href="/">Wizard</a> /
          <a href="/components">componenten</a> /
          <span>{slug}</span>
        </nav>

        <div class="wizard-page-header">
          <h1>{title}</h1>
          <button class="wizard-preset-reset nl-button nl-button--subtle wizard-page-reset" type="button">
            <span class="wizard-page-reset__icon" aria-hidden="true" set:html={refreshIcon} />
            Opnieuw beginnen
          </button>
        </div>
        <StoryWizard wizard={wizard} />
        <a href={`/components/${slug}/tokens`}>Ga naar alle component tokens</a>
      </main>
     </wizard-layout>
  </theme-wizard-app>
</BaseLayout>

<script>
  import '@/components/story-wizard/controller';
  import '@nl-design-system-community/clippy-components/clippy-side-navigation';
</script>
