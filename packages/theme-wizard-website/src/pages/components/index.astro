---
import MainLayout from "@/layouts/MainLayout.astro"
import { getNavigationItems, getSubNavigationItems } from '@/navigation.config';

const mainPath = '/components';
const navigationItems = getNavigationItems(Astro.url.pathname);
const subNavigationItems = getSubNavigationItems(navigationItems, mainPath);
---

<script>
  import '@nl-design-system-community/clippy-components/clippy-story-preview'
</script>

<MainLayout title="Componenten" metaTitle="Componenten" mainPath={mainPath}>
  <clippy-story-preview size="lg">
    <wizard-unstyled-list>
      {subNavigationItems.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </wizard-unstyled-list>
  </clippy-story-preview>
</MainLayout>
