---
import BaseLayout from "@/layouts/BaseLayout.astro"
import { getNavigationItems, getSubNavigationItems } from '@/navigation.config';

const navigationItems = getNavigationItems(Astro.url.pathname);
const subNavigationItems = getSubNavigationItems(navigationItems, '/components');
---

<BaseLayout title="Componenten - Theme Wizard">
  <theme-wizard-app>
    <wizard-layout>
      <wizard-page-header slot="page-header" navigation-items={JSON.stringify(navigationItems)}></wizard-page-header>
      {subNavigationItems ?
        <clippy-side-navigation
          slot="sidebar"
          label="Components"
          items={JSON.stringify(subNavigationItems)}
        ></clippy-side-navigation>
      : null}
      <main slot="main">
        <h1>Componenten</h1>
        <!-- TODO: show list of components with illustrations -->
        <!--https://github.com/nl-design-system/documentatie/tree/a55bc644e9eead2a546b7b1194faca949d41b9f4/static/svg -->
      </main>
     </wizard-layout>
  </theme-wizard-app>
</BaseLayout>
