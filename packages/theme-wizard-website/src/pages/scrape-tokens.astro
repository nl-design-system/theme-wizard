---
import { withRelatedProject } from '@vercel/related-projects';
import MainLayout from '../layouts/MainLayout.astro';

const scraperUrl = withRelatedProject({
  projectName: 'theme-wizard-server',
  // Fallback API host
  defaultHost: process.env.API_HOST || '',
});

const backLink = { href: '/', label: 'Terug naar start' };

// TODO: fix layout exeption
---

<MainLayout title="Maak je eigen thema" metaTitle="Maak je eigen thema" layoutSize="xs" layoutBlockAlignment="center" backLink={backLink}>
  <wizard-scraper scraperUrl={scraperUrl}></wizard-scraper>
</MainLayout>

<script>
  import { navigate } from "astro:transitions/client";

  document.querySelector('theme-wizard-app')?.addEventListener('scrape-success', () => {
    navigate('/staging-tokens')
  })
</script>
