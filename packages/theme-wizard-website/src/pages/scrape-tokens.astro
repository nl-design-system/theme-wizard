---
import { withRelatedProject } from '@vercel/related-projects';
import BaseLayout from '../layouts/BaseLayout.astro';

const scraperUrl = withRelatedProject({
  projectName: 'theme-wizard-server',
  // Fallback API host
  defaultHost: process.env.API_HOST || '',
});
---

<BaseLayout title="Theme Wizard">
  <theme-wizard-app>
    <clippy-page-layout layout-block-alignment="center">
      <wizard-page-header slot="header"></wizard-page-header>
      <clippy-layout size="xs">
        <clippy-main>
          <wizard-scraper scraperUrl={scraperUrl}></wizard-scraper>
        </clippy-main>

      </clippy-layout>
      <wizard-page-footer slot="footer"></wizard-page-footer>
    </clippy-page-layout>

  </theme-wizard-app>
</BaseLayout>

<script>
  import { navigate } from "astro:transitions/client";
  import '@nl-design-system-community/clippy-components/clippy-page-layout';
  import '@nl-design-system-community/clippy-components/clippy-layout';
  import '@nl-design-system-community/clippy-components/clippy-main';

  document.querySelector('theme-wizard-app')?.addEventListener('scrape-success', () => {
    navigate('/staging-tokens')
  })
</script>
