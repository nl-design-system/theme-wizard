---
import '@nl-design-system-community/clippy-components/clippy-stack';
import WizardLayout from '../../layouts/WizardLayout.astro';

export const prerender = false; // enable SSR, needed to read the `from` query param below

// `from` records which page linked here, so the back link returns to that page instead of
// always assuming the staging-tokens flow (e.g. "start from scratch" skips staging entirely).
const backLink =
  Astro.url.searchParams.get('from') === 'staging-tokens'
    ? { href: '/staging-tokens', label: 'Vorige stap' }
    : { href: '/', label: 'Terug naar start' };
---

<script>
  import '@nl-design-system-community/clippy-components/clippy-heading';
  import '@nl-design-system-community/clippy-components/clippy-stack';
</script>

<WizardLayout title="Maak de eerste keuzes voor je thema" backLink={backLink}>
  <p class="nl-paragraph nl-paragraph--lead">Voor een optimaal werkend thema maak je eerst keuzes op hoog niveau.</p>
  <nav aria-labelledby="wizard-nav-title">
    <clippy-stack size="3xl">
      <clippy-heading level="2" id="wizard-nav-title">Maak stapsgewijs keuzes</clippy-heading>
      <wizard-step-form-task-navigation-list></wizard-step-form-task-navigation-list>
    </clippy-stack>
  </nav>
</WizardLayout>
