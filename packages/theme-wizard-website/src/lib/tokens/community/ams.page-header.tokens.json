{
  "ams": {
    "page-header": {
      "background-color": {
        "$type": "color"
      },
      "font-family": {
        "$type": "fontFamilies"
      },
      "padding-block": {
        "$type": "dimension"
      },
      "padding-inline": {
        "$type": "dimension"
      },
      "medium": {
        "padding-inline": {
          "$type": "dimension",
          "$deprecated": "Use `ams.page-header.vi-medium.padding-inline` instead. Will be removed on or after 2026-10-20."
        }
      },
      "wide": {
        "padding-inline": {
          "$type": "dimension",
          "$deprecated": "Use `ams.page-header.vi-wide.padding-inline` instead. Will be removed on or after 2026-10-20."
        }
      },
      "vi-medium": {
        "padding-inline": {
          "$type": "dimension"
        }
      },
      "vi-wide": {
        "padding-inline": {
          "$type": "dimension"
        }
      },
      "logo-link": {
        "column-gap": {
          "$type": "dimension"
        },
        "outline-offset": {
          "$type": "dimension"
        }
      },
      "brand-name": {
        "color": {
          "$type": "color"
        },
        "font-size": {
          "$type": "fontSizes"
        },
        "font-weight": {
          "$type": "fontWeights"
        },
        "line-height": {
          "$type": "lineHeights"
        },
        "text-wrap": {
          "$type": "other"
        }
      },
      "mega-menu": {
        "padding-block": {
          "$type": "dimension"
        },
        "button": {
          "background-color": {
            "$type": "color"
          },
          "border-radius": {
            "$type": "dimension"
          },
          "color": {
            "$type": "color"
          },
          "cursor": {
            "$type": "other"
          },
          "label": {
            "open": {
              "font-weight": {
                "$type": "fontWeights",
                "$deprecated": "We no longer make the button label bold when the mega menu is open. Will be removed on or after 2026-09-13."
              }
            }
          },
          "padding-inline": {
            "$type": "dimension"
          },
          "hover": {
            "background-color": {
              "$type": "color"
            },
            "color": {
              "$type": "color"
            }
          }
        }
      },
      "menu": {
        "column-gap": {
          "$type": "dimension"
        },
        "row-gap": {
          "$type": "dimension"
        },
        "item": {
          "color": {
            "$type": "color",
            "$deprecated": "Use `ams.page-header.menu.link.color` instead. Will be removed on or after 2026-09-13."
          },
          "column-gap": {
            "$type": "dimension"
          },
          "font-family": {
            "$type": "fontFamilies",
            "$deprecated": "Use `ams.page-header.font-family` instead, which the menu items inherit. Will be removed on or after 2027-02-08."
          },
          "font-size": {
            "$type": "fontSizes"
          },
          "font-weight": {
            "$type": "fontWeights"
          },
          "line-height": {
            "$type": "lineHeights"
          },
          "outline-offset": {
            "$type": "dimension"
          },
          "padding-block": {
            "$type": "dimension"
          },
          "hover": {
            "color": {
              "$type": "color"
            }
          }
        },
        "link": {
          "color": {
            "$type": "color"
          },
          "gap": {
            "$type": "dimension"
          },
          "text-decoration-line": {
            "$type": "textDecoration"
          },
          "text-decoration-thickness": {
            "$type": "dimension"
          },
          "text-underline-offset": {
            "$type": "dimension"
          },
          "hover": {
            "text-decoration-line": {
              "$type": "textDecoration"
            }
          }
        }
      },
      "navigation": {
        "column-gap": {
          "$type": "dimension"
        },
        "row-gap": {
          "$type": "dimension"
        }
      }
    }
  }
}
