---
import TokenLinkList from '@/components/TokenLinkList.astro';
import TokenStoryMatches from '@/components/TokenStoryMatches.astro';
import type { TokenNamespaceId } from '@/lib/token-namespaces';
import type { TokenTreeNode } from '@nl-design-system-community/design-tokens-schema';

interface Props {
  namespace: TokenNamespaceId;
  node: TokenTreeNode;
  tokenPath: string;
}

const { namespace, node, tokenPath } = Astro.props;
---

<wizard-token-docs groups={tokenPath} heading-level="none"></wizard-token-docs>

{
  node.isLeaf ? (
    <wizard-token-field path={tokenPath} />
  ) : (
    <wizard-tokens-presets path={tokenPath}></wizard-tokens-presets>
    <TokenLinkList namespace={namespace} nodes={node.children} />
  )
}

{node.isLeaf && <TokenStoryMatches groups={tokenPath} />}

<script>
  import type { WizardTokensPresets } from '@nl-design-system-community/theme-wizard-app';
  import { components } from '@/lib/components';

  for (const element of document.querySelectorAll<WizardTokensPresets>('wizard-tokens-presets')) {
    element.components = components;
  }
</script>
