---
import { getTokenNamespace, type TokenNamespaceId } from '@/lib/token-namespaces';
import type { TokenTreeNode } from '@nl-design-system-community/design-tokens-schema';
import { capitalize } from 'es-toolkit';

interface Props {
  namespace: TokenNamespaceId;
  nodes: TokenTreeNode[];
}

const { namespace, nodes } = Astro.props;
const { nav } = getTokenNamespace(namespace);
---

<wizard-unstyled-list>
  {
    nodes.map((node) => (
      <li>
        <wizard-link-to-token path={nav.tokenPathFor(node.path)}>
          <a slot="link" href={nav.hrefFor(node.path)}>
            Bewerk '{node.key}'
          </a>
          {capitalize(node.key)}
        </wizard-link-to-token>
      </li>
    ))
  }
</wizard-unstyled-list>
