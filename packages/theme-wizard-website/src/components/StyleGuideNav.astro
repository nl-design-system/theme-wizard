---
const slug = Astro.url.pathname;
const pages: { title: string; slug: string }[] = [
  { title: 'Kleur systeem', slug: '/style-guide/color-system' },
  { title: 'Typografie systeem', slug: '/style-guide/typography-system' },
  { title: 'Witruimte systeem', slug: '/style-guide/spacing-system' },
  { title: 'Randen en lijnen systeem', slug: '/style-guide/border-system' },
  { title: 'Design tokens', slug: '/style-guide/design-tokens' },
];
---

<nav slot="sidebar">
  {pages.map((page) => (
    <wizard-sidebar-link href={page.slug} current={slug.includes(page.slug) ? 'page' : undefined}>{page.title}</wizard-sidebar-link>
  ))}
</nav>
