---
interface Props {
  groups: string;
}

const { groups } = Astro.props;
---

<div data-token-story-matches data-groups={groups}></div>

<script>
  import '@nl-design-system-community/clippy-components/clippy-popover';
  import { findMatchingStories } from '@/lib/story-token-matches';
  import { getThemeTokens } from '@/lib/get-live-theme';
  import { mountStory } from '@/components/render-stories';

  function renderMatches(container: HTMLElement, matches: Awaited<ReturnType<typeof findMatchingStories>>) {
    container.replaceChildren();

    for (const { id, story, meta, matchedTokens } of matches) {
      const section = document.createElement('section');
      section.className = 'wizard-story-section';

      const heading = document.createElement('clippy-heading');
      heading.setAttribute('level', '3');
      heading.textContent = id
        .replace(/^Design/, '')
        .replace(/([A-Z])/g, ' $1')
        .trim();

      const preview = document.createElement('clippy-story-preview');
      const reset = document.createElement('clippy-reset-theme');
      const previewTheme = document.createElement('wizard-preview-theme');

      mountStory(previewTheme, {
        args: (story as { args?: unknown }).args ?? {},
        componentMeta: meta,
        story,
      });

      const popover = document.createElement('clippy-popover');
      popover.className = 'tokens-toggle';
      popover.setAttribute('trigger-label', 'Toon gekoppelde tokens');

      const triggerIcon = document.createElement('span');
      triggerIcon.slot = 'trigger';
      triggerIcon.setAttribute('aria-hidden', 'true');
      triggerIcon.textContent = '🕵️‍♂️';
      popover.appendChild(triggerIcon);

      const list = document.createElement('dl');
      for (const { path, ref } of matchedTokens) {
        const term = document.createElement('dt');
        term.textContent = path;
        const description = document.createElement('dd');
        description.textContent = ref;
        list.append(term, description);
      }
      popover.appendChild(list);

      reset.appendChild(previewTheme);
      preview.append(heading, reset, popover);
      section.append(preview);

      container.appendChild(section);
    }
  }

  const containers = [...document.querySelectorAll<HTMLElement>('[data-token-story-matches]')];

  async function renderAllMatches(themeTokens: Record<PropertyKey, unknown>) {
    for (const container of containers) {
      const groups = (container.dataset.groups ?? '')
        .split(',')
        .map((group) => group.trim())
        .filter(Boolean);

      if (groups.length === 0) continue;

      const matches = await findMatchingStories(groups, themeTokens);
      renderMatches(container, matches);
    }
  }

  // Serializes rebuilds and coalesces rapid-fire theme changes (e.g. dragging a color
  // slider) into a single trailing run, so a rebuild never tears down elements that a
  // still-in-flight previous rebuild is mid-render on.
  let isUpdating = false;
  let pendingTokens: Record<PropertyKey, unknown> | undefined;

  async function updateMatches(themeTokens: Record<PropertyKey, unknown> | undefined) {
    if (!themeTokens) return;

    if (isUpdating) {
      pendingTokens = themeTokens;
      return;
    }

    isUpdating = true;
    try {
      await renderAllMatches(themeTokens);
    } finally {
      isUpdating = false;
    }

    if (pendingTokens) {
      const next = pendingTokens;
      pendingTokens = undefined;
      await updateMatches(next);
    }
  }

  if (containers.length > 0) {
    getThemeTokens(containers[0]).then(updateMatches);

    // `<clippy-theme-context>` re-dispatches this (bubbling + composed) whenever the
    // theme changes, so matches stay in sync with live token edits.
    document.addEventListener('theme-change', (event) => {
      updateMatches((event as CustomEvent<{ tokens: Record<PropertyKey, unknown> }>).detail.tokens);
    });
  }
</script>

<style is:global>
  [data-token-story-matches] {
    background: whitesmoke;
    display: flex;
    flex-wrap: wrap;
    row-gap: 1rem;
    column-gap: 1rem;
    padding-inline: 1rem;
    padding-block: 1rem;

    --nl-heading-level-3-font-size: 1rem;
    --nl-heading-level-3-margin-block-end: 0.75rem;
  }

  clippy-story-preview {
    position: relative;
  }

  .tokens-toggle {
    position: absolute;
    top: 0;
    right: 0;
    opacity: 0.3;
  }

  dt {
    font-weight: bold;
  }
</style>
