{
  "ams": {
    "page-header": {
      "background-color": {
        "$type": "color",
        "$value": "{basis.color.accent-2.bg-document}"
      },
      "brand-name": {
        "color": {
          "$type": "color",
          "$value": "{basis.color.accent-2.color-document}"
        }
      },
      "menu": {
        "link": {
          "color": {
            "$type": "color",
            "$value": "{basis.color.accent-2.color-default}"
          }
        },
        "item": {
          "hover": {
            "color": {
              "$type": "color",
              "$value": "{basis.color.accent-2.color-hover}"
            }
          }
        }
      },
      "mega-menu": {
        "button": {
          "background-color": {
            "$type": "color",
            "$value": "{basis.color.accent-2.color-default}"
          },
          "color": {
            "$type": "color",
            "$value": "{basis.color.accent-2.bg-default}"
          },
          "hover": {
            "background-color": {
              "$type": "color",
              "$value": "{basis.color.accent-2.color-hover}"
            },
            "color": {
              "$type": "color",
              "$value": "{basis.color.accent-2.bg-hover}"
            }
          }
        }
      }
    }
  }
