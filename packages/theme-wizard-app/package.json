{
  "name": "@nl-design-system-community/theme-wizard-app",
  "version": "2.3.5",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nl-design-system/theme-wizard.git",
    "directory": "packages/theme-wizard-app"
  },
  "sideEffects": [
    "*.css",
    "dist/**/*.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./theme.css",
    "./clippy-tokens.css": "./clippy-tokens.css",
    "./components/*": {
      "import": "./dist/components/*/index.js",
      "types": "./dist/components/*/index.d.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./dist/utils/index.js"
    }
  },
  "files": [
    "dist",
    "theme.css",
    "clippy-tokens.css"
  ],
  "scripts": {
    "dev": "vite build --watch --mode development --emptyOutDir false",
    "types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "build": "pnpm run type-check && vite build",
    "clean": "premove dist/",
    "lint": "pnpm run --sequential '/^lint:.+$/'",
    "lint:css": "stylelint .",
    "lint:js": "eslint",
    "lint-fix:css": "pnpm run lint:css --fix",
    "lint-fix:js": "eslint --fix",
    "lint-build": "tsc --noEmit --project tsconfig.json",
    "test": "pnpm run '/^test:.+$/'",
    "test-build": "vitest --run --coverage",
    "test:unit": "vitest --run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lit/context": "1.1.6",
    "@nl-design-system-candidate/button-css": "2.0.0",
    "@nl-design-system-candidate/code-css": "4.0.0",
    "@nl-design-system-candidate/data-badge-css": "1.0.5",
    "@nl-design-system-candidate/form-field-error-message-css": "1.0.0",
    "@nl-design-system-candidate/link-css": "3.0.0",
    "@nl-design-system-candidate/paragraph-css": "3.0.0",
    "@nl-design-system-community/clippy-components": "workspace:*",
    "@nl-design-system-community/color-scale-generator": "workspace:*",
    "@nl-design-system-community/css-scraper": "workspace:*",
    "@nl-design-system-community/design-tokens-schema": "workspace:*",
    "@nl-design-system-community/ma-design-tokens": "9.1.0",
    "@nl-design-system-unstable/documentation": "2.0.0",
    "@nl-design-system-unstable/start-design-tokens": "9.2.0",
    "@projectwallace/color-sorter": "9.0.0",
    "@tabler/icons": "3.50.0",
    "@utrecht/alert-css": "4.0.2",
    "@utrecht/checkbox-css": "3.1.0",
    "@utrecht/form-field-css": "3.0.1",
    "@utrecht/form-label-css": "3.0.1",
    "@utrecht/link-button-css": "3.1.0",
    "@utrecht/table-css": "3.0.1",
    "@utrecht/textarea-css": "4.1.0",
    "@utrecht/textbox-css": "4.1.0",
    "@utrecht/web-component-library-stencil": "5.0.0",
    "@vanillawc/wc-markdown": "1.6.11",
    "colorjs.io": "0.7.1",
    "dequal": "2.0.3",
    "dlv": "1.1.3",
    "dset": "3.1.4",
    "es-toolkit": "1.53.1",
    "lit": "3.3.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rosetta": "1.1.0",
    "xstate": "5.33.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nl-design-system-community/vite-plugin-terse-log": "workspace:*",
    "@projectwallace/css-parser": "0.19.3",
    "@storybook/react-vite": "10.6.5",
    "@types/dlv": "1.1.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "playwright": "1.64.1",
    "postcss-lit": "1.4.1",
    "premove": "4.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.0.5"
  }
}
